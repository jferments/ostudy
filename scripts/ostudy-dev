#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'USAGE'
ostudy plain-text developer commands

Usage:
  ./scripts/ostudy-dev <command> [arguments]

Linux:
  setup           Install/provision the Ubuntu/Debian development environment.
  build           Build the standalone desktop application.
  run             Run the existing standalone desktop build.
  desktop         Run Tauri desktop hot reload for deliberate development use.

Checks:
  check-changed   Run the smallest check selected from the current diff.
  check-static    Run static repository/type/format checks.
  check-fast      Run the maintained fast qualification gate.
  check           Run the maintained full Linux qualification gate.

Android:
  android-doctor  Verify the Android development environment.
  android-build   Build a debug ARM64 APK by default; accepts android-build.sh options.
  android-install Build/install on a connected device; accepts android-install.sh options.
  android-test    Run Android compile/package qualification.
  android-smoke   Run the Android emulator smoke test.

Other:
  help            Show this help.

This wrapper is intentionally plain text. It never enters terminal raw mode,
an alternate screen, or a full-screen TUI. The underlying scripts remain the
canonical build/test/install implementations and receive any extra arguments.
USAGE
}

command="${1:-help}"
if (($#)); then
  shift
fi

case "$command" in
  help|-h|--help)
    usage
    ;;
  setup)
    exec "$SCRIPT_DIR/setup-ubuntu.sh" "$@"
    ;;
  build)
    exec "$SCRIPT_DIR/build.sh" "$@"
    ;;
  run)
    exec "$ROOT_DIR/run-app.sh" "$@"
    ;;
  desktop|dev)
    exec "$SCRIPT_DIR/dev.sh" "$@"
    ;;
  check-changed)
    exec "$SCRIPT_DIR/check-changed.sh" "$@"
    ;;
  check-static)
    exec "$SCRIPT_DIR/check-static.sh" "$@"
    ;;
  check-fast|test)
    exec "$SCRIPT_DIR/check-fast.sh" "$@"
    ;;
  check|test-full)
    exec "$SCRIPT_DIR/check.sh" "$@"
    ;;
  android-doctor)
    exec "$SCRIPT_DIR/android-doctor.sh" "$@"
    ;;
  android-build)
    exec "$SCRIPT_DIR/android-build.sh" "$@"
    ;;
  android-install)
    exec "$SCRIPT_DIR/android-install.sh" "$@"
    ;;
  android-test)
    exec "$SCRIPT_DIR/android-test.sh" "$@"
    ;;
  android-smoke)
    exec "$SCRIPT_DIR/android-emulator-smoke.sh" "$@"
    ;;
  *)
    printf 'Unknown ostudy developer command: %s\n\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
