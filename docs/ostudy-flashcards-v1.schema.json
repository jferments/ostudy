{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostudy.local/schemas/ostudy-flashcards-v1.schema.json",
  "title": "ostudy Flashcard Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "deck", "cards"],
  "properties": {
    "format": { "const": "ostudy-flashcards" },
    "formatVersion": { "const": 1 },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000, "default": "" }
      }
    },
    "defaultTags": { "$ref": "#/$defs/tags" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/basicCard" },
          { "$ref": "#/$defs/clozeCard" }
        ]
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "default": []
    },
    "basicCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "front", "back"],
      "properties": {
        "type": { "const": "basic" },
        "front": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "back": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "reverseEnabled": { "type": "boolean", "default": false },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "clozeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "cloze" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "mode": {
          "type": "string",
          "enum": ["one_at_a_time", "all_together"],
          "default": "one_at_a_time"
        },
        "tags": { "$ref": "#/$defs/tags" }
      }
    }
  }
}
