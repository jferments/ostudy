{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostudy.local/schemas/ostudy-flashcards-v2.schema.json",
  "title": "ostudy Flashcard Import v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "deck", "cards"],
  "properties": {
    "format": { "const": "ostudy-flashcards" },
    "formatVersion": { "const": 2 },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "name"],
      "properties": {
        "mode": { "type": "string", "enum": ["create", "append"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000, "default": "" }
      },
      "allOf": [{
        "if": { "properties": { "mode": { "const": "append" } }, "required": ["mode"] },
        "then": { "properties": { "description": { "maxLength": 0 } } }
      }]
    },
    "defaultTags": { "$ref": "#/$defs/tags" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/basicCard" },
          { "$ref": "#/$defs/clozeCard" },
          { "$ref": "#/$defs/interactiveCard" }
        ]
      }
    }
  },
  "$defs": {
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "default": []
    },
    "componentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 200000 },
    "basicCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "front", "back"],
      "properties": {
        "type": { "const": "basic" },
        "front": { "$ref": "#/$defs/markdown" },
        "back": { "$ref": "#/$defs/markdown" },
        "reverseEnabled": { "type": "boolean", "default": false },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "clozeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "cloze" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "mode": {
          "type": "string",
          "enum": ["one_at_a_time", "all_together"],
          "default": "one_at_a_time"
        },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "interactiveCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question"],
      "properties": {
        "type": { "const": "interactive" },
        "question": {
          "oneOf": [
            { "$ref": "#/$defs/singleChoice" },
            { "$ref": "#/$defs/selectAll" },
            { "$ref": "#/$defs/trueFalse" },
            { "$ref": "#/$defs/matching" },
            { "$ref": "#/$defs/grouping" },
            { "$ref": "#/$defs/ordering" }
          ]
        },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "content": { "$ref": "#/$defs/markdown" },
        "rationale": { "$ref": "#/$defs/markdown" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "content": { "$ref": "#/$defs/markdown" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "left", "right"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "left": { "$ref": "#/$defs/markdown" },
        "right": { "$ref": "#/$defs/markdown" },
        "rationale": { "$ref": "#/$defs/markdown" }
      }
    },
    "groupedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "categoryId"],
      "properties": {
        "id": { "$ref": "#/$defs/componentId" },
        "content": { "$ref": "#/$defs/markdown" },
        "categoryId": { "$ref": "#/$defs/componentId" },
        "rationale": { "$ref": "#/$defs/markdown" }
      }
    },
    "singleChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "options", "correctOptionId"],
      "properties": {
        "kind": { "const": "single_choice" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "options": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/option" } },
        "correctOptionId": { "$ref": "#/$defs/componentId" },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    },
    "selectAll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "options", "correctOptionIds"],
      "properties": {
        "kind": { "const": "select_all" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "options": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/option" } },
        "correctOptionIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/componentId" } },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    },
    "trueFalse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement", "correct"],
      "properties": {
        "kind": { "const": "true_false" },
        "statement": { "$ref": "#/$defs/markdown" },
        "correct": { "type": "boolean" },
        "explanation": { "$ref": "#/$defs/markdown" },
        "correctedStatement": { "$ref": "#/$defs/markdown" }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "pairs"],
      "properties": {
        "kind": { "const": "matching" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "pairs": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/pair" } },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "categories", "items"],
      "properties": {
        "kind": { "const": "grouping" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "categories": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/item" } },
        "items": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/groupedItem" } },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "items"],
      "properties": {
        "kind": { "const": "ordering" },
        "prompt": { "$ref": "#/$defs/markdown" },
        "items": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/item" } },
        "explanation": { "$ref": "#/$defs/markdown" }
      }
    }
  }
}
