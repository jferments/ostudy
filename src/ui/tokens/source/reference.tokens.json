{
  "color": {
    "neutral": {
      "0": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "950": {
        "$type": "color",
        "$value": "#0d1118"
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0px"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "7": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "8": {
      "$type": "dimension",
      "$value": "2.5rem"
    },
    "9": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "10": {
      "$type": "dimension",
      "$value": "4rem"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "$value": "2.625rem"
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "max(44px, 2.75rem)"
    },
    "iconSmall": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "iconMedium": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "iconLarge": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "contentReading": {
      "$type": "dimension",
      "$value": "720px"
    },
    "contentWorkspace": {
      "$type": "dimension",
      "$value": "1180px"
    },
    "contentWide": {
      "$type": "dimension",
      "$value": "1440px"
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "1ms"
      },
      "micro": {
        "$type": "duration",
        "$value": "90ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "140ms"
      },
      "standard": {
        "$type": "duration",
        "$value": "220ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      },
      "celebration": {
        "$type": "duration",
        "$value": "900ms"
      },
      "flip": {
        "$type": "duration",
        "$value": "560ms"
      },
      "skeleton": {
        "$type": "duration",
        "$value": "1400ms"
      }
    },
    "ease": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "press": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      },
      "reorder": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
      }
    }
  },
  "font": {
    "family": {
      "system": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      },
      "study": {
        "$type": "fontFamily",
        "$value": "'Atkinson Hyperlegible Next', 'Atkinson Hyperlegible', ui-sans-serif, system-ui, sans-serif"
      },
      "technical": {
        "$type": "fontFamily",
        "$value": "'IBM Plex Sans', 'Atkinson Hyperlegible Next', ui-sans-serif, system-ui, sans-serif"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Georgia, 'Times New Roman', serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'Atkinson Hyperlegible Mono', 'IBM Plex Mono', 'Cascadia Code', 'Liberation Mono', monospace"
      }
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "label": {
        "$type": "dimension",
        "$value": "0.8125rem"
      },
      "small": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "body": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "bodyLarge": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "titleSmall": {
        "$type": "dimension",
        "$value": "1.1875rem"
      },
      "section": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "title": {
        "$type": "dimension",
        "$value": "clamp(1.75rem, 1.2rem + 1.6vw, 2.125rem)"
      },
      "display": {
        "$type": "dimension",
        "$value": "clamp(2.25rem, 1.5rem + 2.5vw, 2.75rem)"
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": "1.2"
      },
      "standard": {
        "$type": "number",
        "$value": "1.5"
      },
      "reading": {
        "$type": "number",
        "$value": "1.65"
      },
      "caption": {
        "$type": "number",
        "$value": "calc(1 / 0.75)"
      },
      "label": {
        "$type": "number",
        "$value": "calc(1.125 / 0.8125)"
      },
      "small": {
        "$type": "number",
        "$value": "calc(1.25 / 0.875)"
      },
      "body": {
        "$type": "number",
        "$value": "1.5"
      },
      "bodyLarge": {
        "$type": "number",
        "$value": "calc(1.75 / 1.125)"
      },
      "titleSmall": {
        "$type": "number",
        "$value": "1.3"
      },
      "section": {
        "$type": "number",
        "$value": "calc(2 / 1.5)"
      },
      "title": {
        "$type": "number",
        "$value": "1.2"
      },
      "display": {
        "$type": "number",
        "$value": "1.1"
      }
    },
    "weight": {
      "regular": {
        "$type": "number",
        "$value": "400"
      },
      "medium": {
        "$type": "number",
        "$value": "500"
      },
      "semibold": {
        "$type": "number",
        "$value": "600"
      },
      "bold": {
        "$type": "number",
        "$value": "700"
      }
    },
    "letterSpacing": {
      "normal": {
        "$type": "dimension",
        "$value": "0em"
      },
      "tight": {
        "$type": "dimension",
        "$value": "-0.01em"
      },
      "tighter": {
        "$type": "dimension",
        "$value": "-0.025em"
      }
    }
  },
  "layer": {
    "base": {
      "$type": "number",
      "$value": "0"
    },
    "selected": {
      "$type": "number",
      "$value": "1"
    },
    "focus": {
      "$type": "number",
      "$value": "2"
    },
    "sticky": {
      "$type": "number",
      "$value": "100"
    },
    "popover": {
      "$type": "number",
      "$value": "500"
    },
    "dialog": {
      "$type": "number",
      "$value": "1000"
    },
    "toast": {
      "$type": "number",
      "$value": "1200"
    },
    "effects": {
      "$type": "number",
      "$value": "1300"
    }
  }
}
