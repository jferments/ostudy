{
  "$theme": "synthwave",
  "color": {
    "canvas": {
      "$type": "color",
      "$value": "#120A23"
    },
    "canvasInset": {
      "$type": "color",
      "$value": "#0D0719"
    },
    "surface": {
      "base": {
        "$type": "color",
        "$value": "#1B1232"
      },
      "soft": {
        "$type": "color",
        "$value": "#21173C"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.surface.base}"
      },
      "chrome": {
        "$type": "color",
        "$value": "{color.surface.base}"
      },
      "overlay": {
        "$type": "color",
        "$value": "{color.surface.base}"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.accent.soft}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.text.primary}"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.surface.base}"
      }
    },
    "navigation": {
      "base": {
        "$type": "color",
        "$value": "#170E2C"
      },
      "text": {
        "$type": "color",
        "$value": "#C3B2E0"
      },
      "hover": {
        "$type": "color",
        "$value": "#241843"
      },
      "selected": {
        "$type": "color",
        "$value": "#3A1F4F"
      },
      "selectedText": {
        "$type": "color",
        "$value": "{color.text.accent}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#FCF3FF"
      },
      "secondary": {
        "$type": "color",
        "$value": "#DDCCF2"
      },
