      "inverse": {
        "$type": "color",
        "$value": "{color.accent.on}"
      },
      "accent": {
        "$type": "color",
        "$value": "#FF92CF"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "#33265A"
      },
      "strong": {
        "$type": "color",
        "$value": "#4F3B86"
      },
      "accent": {
        "$type": "color",
        "$value": "{color.accent.base}"
      }
    },
    "accent": {
      "base": {
        "$type": "color",
        "$value": "#FF5FB4"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.text.accent}"
      },
      "soft": {
        "$type": "color",
        "$value": "rgb(255 95 180 / 16%)"
      },
      "on": {
        "$type": "color",
        "$value": "#1A0820"
      },
      "secondary": {
        "$type": "color",
        "$value": "#46E0FF"
      }
    },
    "highlight": {
      "$type": "color",
      "$value": "rgb(70 224 255 / 22%)"
    },
    "page": {
      "$type": "color",
      "$value": "#EDE6F5"
    },
    "pageInk": {
      "$type": "color",
      "$value": "#241A33"
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.accent.base}"
      }
    },
    "selection": {
      "background": {
        "$type": "color",
        "$value": "rgb(255 95 180 / 34%)"
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.text.primary}"
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#7CFFB2"
      },
      "successSoft": {
        "$type": "color",
        "$value": "rgb(124 255 178 / 12%)"
      },
      "warning": {
        "$type": "color",
        "$value": "#FFC266"
      },
      "warningSoft": {
        "$type": "color",
        "$value": "rgb(255 194 102 / 13%)"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF7A8A"
      },
      "dangerSoft": {
        "$type": "color",
        "$value": "rgb(255 122 138 / 15%)"
      },
      "info": {
        "$type": "color",
        "$value": "{color.text.accent}"
      },
      "infoSoft": {
        "$type": "color",
        "$value": "{color.accent.soft}"
      },
      "dangerOn": {
        "$type": "color",
        "$value": "#1A0820"
      }
    },
    "confidence": {
      "0": {
        "$type": "color",
        "$value": "{color.status.danger}"
      },
      "1": {
