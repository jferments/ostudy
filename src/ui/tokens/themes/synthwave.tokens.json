      "3Soft": {
        "$type": "color",
        "$value": "rgb(255 179 71 / 14%)"
      },
      "4Soft": {
        "$type": "color",
        "$value": "rgb(185 140 255 / 16%)"
      },
      "5Soft": {
        "$type": "color",
        "$value": "rgb(124 255 178 / 13%)"
      },
      "6Soft": {
        "$type": "color",
        "$value": "rgb(255 122 122 / 15%)"
      }
    },
    "chart": {
      "1": {
        "$type": "color",
        "$value": "{color.subject.1}"
      },
      "2": {
        "$type": "color",
        "$value": "{color.subject.2}"
      },
      "3": {
        "$type": "color",
        "$value": "{color.subject.3}"
      },
      "4": {
        "$type": "color",
        "$value": "{color.subject.4}"
      },
      "5": {
        "$type": "color",
        "$value": "{color.subject.5}"
      },
      "6": {
        "$type": "color",
        "$value": "{color.subject.6}"
      },
      "grid": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      }
    },
    "progress": {
      "track": {
        "$type": "color",
        "$value": "{color.border.subtle}"
      },
      "fill": {
        "$type": "color",
        "$value": "{color.accent.base}"
      }
    },
    "overlay": {
      "scrim": {
        "$type": "color",
        "$value": "rgb(5 3 14 / 73%)"
      }
    }
  },
  "radius": {
    "small": {
      "$type": "dimension",
      "$value": "10px"
    },
    "medium": {
      "$type": "dimension",
      "$value": "14px"
    },
    "large": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xlarge": {
      "$type": "dimension",
      "$value": "28px"
    },
    "button": {
      "$type": "dimension",
      "$value": "{radius.pill}"
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": "var(--ui-font-family)"
      }
    }
  },
  "shadow": {
    "level1": {
      "$type": "shadow",
      "$value": "0 14px 34px rgb(4 0 16 / 55%)"
    },
    "level2": {
      "$type": "shadow",
      "$value": "0 18px 40px rgb(4 0 16 / 60%)"
    },
    "level3": {
      "$type": "shadow",
      "$value": "0 22px 48px rgb(4 0 16 / 64%)"
    },
    "level4": {
      "$type": "shadow",
      "$value": "0 28px 60px rgb(4 0 16 / 68%)"
    },
    "level5": {
      "$type": "shadow",
      "$value": "0 36px 76px rgb(4 0 16 / 72%)"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 3px rgb(255 95 180 / 38%)"
    }
  },
  "glow": {
    "accent": {
      "$type": "shadow",
      "$value": "0 0 0 1px rgb(255 95 180 / 60%), 0 8px 28px rgb(255 95 180 / 35%)"
    }
  }
