      "1": {
        "$type": "color",
        "$value": "#FF5FB4"
      },
      "2": {
        "$type": "color",
        "$value": "#46E0FF"
      },
      "3": {
        "$type": "color",
        "$value": "#FFB347"
      },
      "4": {
        "$type": "color",
        "$value": "#B98CFF"
