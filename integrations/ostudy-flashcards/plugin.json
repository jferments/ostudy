{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ostudy-flashcards",
  "version": "0.1.0",
  "description": "Create validated oStudy flashcard import files from topics, text, and documents.",
  "author": {
    "name": "jferments",
    "url": "https://ostudy.io/"
  },
  "homepage": "https://ostudy.io/",
  "repository": "https://github.com/jferments/ostudy",
  "license": "MIT",
  "keywords": [
    "ostudy",
    "flashcards",
    "study",
    "education"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "oStudy Flashcards",
        "shortDescription": "Create oStudy flashcard decks",
        "longDescription": "Generate validated .ostudy.json flashcard decks from topics, supplied text, and documents without an MCP server or direct access to the user's oStudy library.",
        "developerName": "jferments",
        "category": "Education & Research",
        "capabilities": [
          "Generate flashcards",
          "Create oStudy import files"
        ],
        "websiteURL": "https://ostudy.io/",
        "privacyPolicyURL": "https://ostudy.io/privacy/",
        "termsOfServiceURL": "https://ostudy.io/terms/",
        "defaultPrompt": [
          "Create an oStudy flashcard deck from this topic.",
          "Create source-grounded oStudy flashcards from the attached document."
        ],
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png",
        "supportURL": "https://ostudy.io/contact/"
      }
    }
  }
}
