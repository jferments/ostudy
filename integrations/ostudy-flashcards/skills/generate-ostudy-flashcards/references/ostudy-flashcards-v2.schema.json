{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostudy.local/schemas/ostudy-flashcards-v2.schema.json",
  "title": "ostudy Flashcard Import v2",
  "description": "Strict content-only authoring envelope for Basic, Cloze, and text-native interactive oStudy flashcards. Cross-reference and restricted-Markdown semantics are additionally enforced by oStudy's importer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "deck",
    "cards"
  ],
  "properties": {
    "format": {
      "const": "ostudy-flashcards"
    },
    "formatVersion": {
      "const": 2
    },
    "deck": {
      "$ref": "#/$defs/deck"
    },
    "defaultTags": {
      "$ref": "#/$defs/tags"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/basicCard"
          },
          {
            "$ref": "#/$defs/clozeCard"
          },
          {
            "$ref": "#/$defs/interactiveCard"
          }
        ]
      }
    }
  },
  "$defs": {
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "name"
      ],
      "properties": {
        "mode": {
          "enum": [
            "create",
            "append"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "append"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "description": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "default": []
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "richText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "optionalRichText": {
      "anyOf": [
        {
          "$ref": "#/$defs/richText"
        },
        {
          "type": "null"
        }
      ]
    },
    "basicCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "front",
        "back"
      ],
      "properties": {
        "type": {
          "const": "basic"
        },
        "front": {
          "$ref": "#/$defs/richText"
        },
        "back": {
          "$ref": "#/$defs/richText"
        },
        "reverseEnabled": {
          "type": "boolean",
          "default": false
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "clozeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "cloze"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "mode": {
          "enum": [
            "one_at_a_time",
            "all_together"
          ],
          "default": "one_at_a_time"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "interactiveCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "question"
      ],
      "properties": {
        "type": {
          "const": "interactive"
        },
        "question": {
          "oneOf": [
            {
              "$ref": "#/$defs/singleChoice"
            },
            {
              "$ref": "#/$defs/selectAll"
            },
            {
              "$ref": "#/$defs/trueFalse"
            },
            {
              "$ref": "#/$defs/matching"
            },
            {
              "$ref": "#/$defs/grouping"
            },
            {
              "$ref": "#/$defs/ordering"
            }
          ]
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "content": {
          "$ref": "#/$defs/richText"
        },
        "rationale": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "content": {
          "$ref": "#/$defs/richText"
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "left",
        "right"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "left": {
          "$ref": "#/$defs/richText"
        },
        "right": {
          "$ref": "#/$defs/richText"
        },
        "rationale": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "groupedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "categoryId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "content": {
          "$ref": "#/$defs/richText"
        },
        "categoryId": {
          "$ref": "#/$defs/localId"
        },
        "rationale": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "singleChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "options",
        "correctOptionId"
      ],
      "properties": {
        "kind": {
          "const": "single_choice"
        },
        "prompt": {
          "$ref": "#/$defs/richText"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionId": {
          "$ref": "#/$defs/localId"
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "selectAll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "options",
        "correctOptionIds"
      ],
      "properties": {
        "kind": {
          "const": "select_all"
        },
        "prompt": {
          "$ref": "#/$defs/richText"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/localId"
          }
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "trueFalse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "statement",
        "correct"
      ],
      "properties": {
        "kind": {
          "const": "true_false"
        },
        "statement": {
          "$ref": "#/$defs/richText"
        },
        "correct": {
          "type": "boolean"
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        },
        "correctedStatement": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "pairs"
      ],
      "properties": {
        "kind": {
          "const": "matching"
        },
        "prompt": {
          "$ref": "#/$defs/richText"
        },
        "pairs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "categories",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "grouping"
        },
        "prompt": {
          "$ref": "#/$defs/richText"
        },
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/groupedItem"
          }
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "ordering"
        },
        "prompt": {
          "$ref": "#/$defs/richText"
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "explanation": {
          "$ref": "#/$defs/optionalRichText"
        }
      }
    }
  }
}
