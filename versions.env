# Android A1-A3 toolchain. The command-line tools archive and checksum are
# published by Android Developers for the stable 2026.1.2 toolchain.
ANDROID_JDK_MAJOR=17
ANDROID_MIN_SDK=28
ANDROID_COMPILE_SDK=36
ANDROID_TARGET_SDK=36
ANDROID_BUILD_TOOLS_VERSION=36.0.0
ANDROID_PLATFORM_TOOLS_VERSION=37.0.0
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_GRADLE_PLUGIN_VERSION=8.10.1
ANDROID_GRADLE_VERSION=8.13
ANDROID_KOTLIN_VERSION=1.9.25
# kotlinx-coroutines 1.9+ is built with Kotlin 2.x metadata. Keep the A1-A3
# plugin on the latest 1.8 line while the generated Tauri project uses Kotlin
# 1.9.25; the plugin only needs stable CoroutineScope/Dispatchers APIs.
ANDROID_COROUTINES_VERSION=1.8.1
ANDROID_COMMANDLINE_TOOLS_BUILD=15859902
ANDROID_COMMANDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
