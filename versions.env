# Android A1-A3 toolchain. The command-line tools archive and checksum are
# published by Android Developers for the stable 2026.1.2 toolchain.
ANDROID_JDK_MAJOR=17
ANDROID_MIN_SDK=28
ANDROID_COMPILE_SDK=36
ANDROID_TARGET_SDK=36
ANDROID_BUILD_TOOLS_VERSION=36.0.0
ANDROID_PLATFORM_TOOLS_VERSION=37.0.0
