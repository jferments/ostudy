{
  "name": "ostudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "postinstall": "node ./scripts/install-local-fonts.mjs",
    "predev": "node ./scripts/install-local-fonts.mjs",
    "prebuild": "node ./scripts/install-local-fonts.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node ./scripts/verify-local-fonts.mjs --packaged",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings=0",
    "tauri": "tauri",
    "desktop": "./scripts/dev.sh",
    "build:app": "./scripts/build.sh",
    "check": "./scripts/check.sh",
    "check:static": "./scripts/check-static.sh",
    "check:fast": "./scripts/check-fast.sh",
    "check:changed": "./scripts/check-changed.sh",
    "fonts:install": "node ./scripts/install-local-fonts.mjs",
    "android:install-deps": "bash ./scripts/install-android-deps.sh --with-emulator",
    "android:doctor": "bash ./scripts/android-doctor.sh",
    "android:doctor:emulator": "bash ./scripts/android-doctor.sh --emulator",
    "android:diagnostics": "bash ./scripts/android-diagnostics.sh",
    "android:runner:doctor": "bash ./scripts/android-runner-doctor.sh",
    "android:dev": "bash ./scripts/android-dev.sh",
    "android:build:debug": "bash ./scripts/android-build.sh --debug --apk --target aarch64",
    "android:build:emulator": "bash ./scripts/android-build.sh --debug --apk --target x86_64",
    "android:build:release": "bash ./scripts/android-build.sh --release --apk --target all",
    "android:build:aab": "bash ./scripts/android-build.sh --release --aab --target all",
    "android:install": "bash ./scripts/android-install.sh --debug --target aarch64",
    "android:install:existing": "bash ./scripts/android-install.sh --debug --no-build",
    "android:avd": "bash ./scripts/android-avd.sh",
    "android:test": "bash ./scripts/android-test.sh",
    "android:smoke": "bash ./scripts/android-emulator-smoke.sh",
    "verify:versions": "node ./scripts/verify-js-dependencies.mjs",
    "verify:manifests": "node ./scripts/verify-project-manifests.mjs",
    "verify:docs": "node ./scripts/verify-documentation.mjs",
    "verify:fonts": "node ./scripts/verify-local-fonts.mjs --installed",
    "verify:ui-tokens": "node ./scripts/generate-ui-tokens.mjs --check && node ./scripts/verify-ui-token-usage.mjs",
    "verify:platform": "node ./scripts/verify-platform-boundaries.mjs",
    "verify:android": "node ./scripts/verify-android-project.mjs && node ./scripts/verify-android-plugin-routing.mjs",
    "verify:contracts": "node ./scripts/verify-ipc-contract.mjs && node ./scripts/verify-repository-policy.mjs && node ./scripts/verify-platform-boundaries.mjs",
    "verify:ui-boundaries": "node ./scripts/verify-ui-boundaries.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tiptap/core": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@tiptap/extension-highlight": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-text-align": "3.28.0",
    "@tiptap/extension-text-style": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1",
    "marked": "18.0.12",
    "@base-ui/react": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "katex": "0.18.7",
    "mathlive": "0.110.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "24.13.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "@typescript-eslint/parser": "8.46.1"
  },
  "description": "A free, local-first flashcard and study application with optional AI-assisted authoring",
  "license": "MIT"
}
