{
  "name": "ostudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "./scripts/dev.sh",
    "build:app": "./scripts/build.sh",
    "check": "./scripts/check.sh",
    "check:static": "./scripts/check-static.sh",
    "check:fast": "./scripts/check-fast.sh",
    "check:changed": "./scripts/check-changed.sh",
    "check:diagnostic": "bash ./scripts/check-diagnostic.sh --profile core",
    "android:install-deps": "bash ./scripts/install-android-deps.sh --with-emulator",
    "android:doctor": "bash ./scripts/android-doctor.sh",
    "android:doctor:emulator": "bash ./scripts/android-doctor.sh --emulator",
    "android:runner:doctor": "bash ./scripts/android-runner-doctor.sh",
    "android:dev": "bash ./scripts/android-dev.sh",
    "android:build:debug": "bash ./scripts/android-build.sh --debug --apk --target aarch64",
    "android:build:emulator": "bash ./scripts/android-build.sh --debug --apk --target x86_64",
    "android:build:aab": "bash ./scripts/android-build.sh --release --aab --target all",
    "android:avd": "bash ./scripts/android-avd.sh",
    "android:test": "bash ./scripts/android-test.sh",
    "android:smoke": "bash ./scripts/android-emulator-smoke.sh",
    "android:diagnostic": "bash ./scripts/check-diagnostic.sh --profile android",
    "android:smoke:min": "bash ./scripts/android-min-sdk-smoke.sh",
    "verify:versions": "node ./scripts/verify-js-dependencies.mjs",
    "verify:manifests": "node ./scripts/verify-project-manifests.mjs",
    "verify:docs": "node ./scripts/verify-documentation.mjs",
    "verify:ui-tokens": "node ./scripts/generate-ui-tokens.mjs --check && node ./scripts/verify-ui-token-usage.mjs",
    "verify:platform": "node ./scripts/verify-platform-boundaries.mjs",
    "verify:android": "node ./scripts/verify-android-project.mjs",
    "verify:contracts": "node ./scripts/verify-ipc-contract.mjs && node ./scripts/verify-repository-policy.mjs && node ./scripts/verify-platform-boundaries.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tiptap/core": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@tiptap/extension-highlight": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-text-align": "3.28.0",
    "@tiptap/extension-text-style": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "description": "A free, local-first flashcard and study application with optional AI-assisted authoring",
  "license": "MIT"
}
