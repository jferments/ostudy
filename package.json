{
  "name": "ostudy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "./scripts/dev.sh",
    "build:app": "./scripts/build.sh",
    "check": "./scripts/check.sh",
    "check:static": "./scripts/check-static.sh",
    "check:fast": "./scripts/check-fast.sh",
    "check:changed": "./scripts/check-changed.sh",
    "verify:versions": "node ./scripts/verify-js-dependencies.mjs",
    "verify:manifests": "node ./scripts/verify-project-manifests.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tiptap/core": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@tiptap/extension-highlight": "3.28.0",
    "@tiptap/extension-image": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-text-align": "3.28.0",
    "@tiptap/extension-text-style": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "description": "A free, local-first desktop flashcard and study application",
  "license": "MIT"
}
