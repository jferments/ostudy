{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ostudy",
        "url": "index.html",
        "width": 1280,
        "height": 760,
        "center": true,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "resources": {
      "resources/native/pdfium/*": "native/pdfium/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-ostudy-android-usb.rules": "../packaging/linux/70-ostudy-android-usb.rules"
        }
      }
    }
  }
}
