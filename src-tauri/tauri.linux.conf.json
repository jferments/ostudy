{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ostudy",
        "url": "index.html",
        "width": 1280,
        "height": 760,
        "center": true,
        "maximized": true,
        "minWidth": 380,
        "minHeight": 520,
        "backgroundColor": "#0d1117",
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "resources": {
      "resources/native/pdfium/*": "native/pdfium/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0",
          "ca-certificates"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-ostudy-android-usb.rules": "packaging/linux/70-ostudy-android-usb.rules"
        }
      },
      "rpm": {
        "depends": [
          "libusb-1.0.so.0()(64bit)",
          "ca-certificates"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-ostudy-android-usb.rules": "packaging/linux/70-ostudy-android-usb.rules"
        }
      }
    }
  }
}
