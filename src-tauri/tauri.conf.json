{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ostudy",
  "version": "0.1.0",
  "identifier": "io.github.jferments.ostudy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ostudy",
        "width": 1280,
        "height": 760,
        "center": true,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost ostudy-asset: http://ostudy-asset.localhost https://ostudy-asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/images/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local-first flashcards and study tools",
    "longDescription": "A free, local-first flashcard and study application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["studydeck"],
        "mimeType": "application/vnd.ostudy.studydeck",
        "name": "ostudy deck"
      },
      {
        "ext": ["ostudybackup"],
        "mimeType": "application/vnd.ostudy.backup",
        "name": "ostudy backup"
      },
      {
        "ext": ["json"],
        "mimeType": "application/json",
        "name": "ostudy generated flashcards"
      }
    ]
  }
}
